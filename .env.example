# DocFlow 配置模板：复制为 .env 后按需修改（全部可留默认，纯规则+OCR 即可运行）
# HOST=127.0.0.1
# ACCESS_PASSWORD=
# SESSION_TTL_HOURS=168
# MAX_UPLOAD_MB=200

# AI（OpenAI 兼容，可选）：规则不确定时兜底
# AI_ENABLED=false
# AI_BASE_URL=
# AI_API_KEY=
*** AI_MODEL=

# 目录监控（无人值守）
# WATCH_ENABLED=false
# WATCH_DIRS=[]
# WATCH_INTERVAL=30

# 邮箱接收（手机拍照发邮件即归档）
# EMAIL_ENABLED=false
# EMAIL_IMAP_HOST=
# EMAIL_USER=
# EMAIL_PASSWORD=
*** EMAIL_SENDER_WHITELIST=
# EMAIL_SUBJECT_PREFIX=整理

# 对账巡检 / 自动备份
# RECON_ENABLED=false
# AUTO_BACKUP_ENABLED=true
# AUTO_BACKUP_KEEP=7

# 回收站保留天数（0=永不自动清理）
# RECYCLE_RETENTION_DAYS=30